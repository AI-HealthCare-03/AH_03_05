# API 서버 URL
# 기본값: http://localhost:80/api/v1 (Docker Nginx 통해 접근)
#
# ⚠️ 실기기(Android/iOS) 테스트 시 필수 설정
#   localhost는 실기기에서 PC를 가리키지 않습니다.
#   PC의 로컬 IP 주소로 변경해야 합니다.
#   예) ipconfig (Windows) 또는 ifconfig (Mac) 로 IP 확인 후 아래처럼 설정
#
# EXPO_PUBLIC_API_URL=http://192.168.x.x:80/api/v1
#
# 배포(prod): https://medipt05.store/api/v1
#   ⚠️ /api/v1 경로까지 반드시 포함 (nginx /api/ 프록시 + FastAPI /api/v1 prefix)
EXPO_PUBLIC_API_URL=http://localhost:80/api/v1